<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_telegram_id" model="ir.ui.view">
        <field name="name">res.users.telegram.user.id</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="telegram_user_id" placeholder="Telegram user id (bot eşlemesi için)"/>
            </xpath>
        </field>
    </record>
</odoo>
