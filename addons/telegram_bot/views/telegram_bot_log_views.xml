<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_bot_log_list" model="ir.ui.view">
        <field name="name">telegram.bot.log.list</field>
        <field name="model">telegram.bot.log</field>
        <field name="arch" type="xml">
            <list string="Telegram Bot Log" create="false" edit="false">
                <field name="create_date" string="Time"/>
                <field name="username"/>
                <field name="chat_id"/>
                <field name="command"/>
                <field name="reply" placeholder="—"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_bot_log_search" model="ir.ui.view">
        <field name="name">telegram.bot.log.search</field>
        <field name="model">telegram.bot.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="username"/>
                <field name="chat_id"/>
                <field name="command"/>
            </search>
        </field>
    </record>

    <record id="action_telegram_bot_log" model="ir.actions.act_window">
        <field name="name">Telegram Bot Log</field>
        <field name="res_model">telegram.bot.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_telegram_bot_log_root" name="Telegram Bot Log"
              action="action_telegram_bot_log" sequence="90"/>
</odoo>
