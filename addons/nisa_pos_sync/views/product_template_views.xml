<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ürün formu: buton + POS sekmesi -->
    <record id="product_template_form_view_nisa_pos" model="ir.ui.view">
        <field name="name">product.template.form.nisa.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_nisa_sync_to_pos" type="object"
                        class="oe_stat_button" icon="fa-refresh"
                        invisible="not id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">POS'a Gönder</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="nisa_pos" string="NISA POS">
                    <group>
                        <field name="external_pos_id"/>
                        <field name="nisa_stock_qty"/>
                        <field name="nisa_last_sync"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Liste ekranında "Eylem" menüsüne eklenen toplu senkron server action'ı -->
    <record id="action_nisa_sync_products" model="ir.actions.server">
        <field name="name">NISA POS'a Senkronize Et</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_nisa_sync_to_pos()</field>
    </record>
</odoo>
