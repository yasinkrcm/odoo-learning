<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_sales_analysis_own" model="ir.rule">
        <field name="name">Sales Analysis: own sales only</field>
        <field name="model_id" ref="model_sales_analysis"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_sales_analysis_all" model="ir.rule">
        <field name="name">Sales Analysis: all sales</field>
        <field name="model_id" ref="model_sales_analysis"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
</odoo>