<odoo>
    <record id="group_todo_manager" model="res.groups">
        <field name="name">Todo Manager</field>
    </record>

    <record id="rule_todo_own_records" model="ir.rule">
        <field name="name">Todo: own records only</field>
        <field name="model_id" ref="model_my_todo"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_todo_manager_all" model="ir.rule">
        <field name="name">Todo: managers see all</field>
        <field name="model_id" ref="model_my_todo"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_todo_manager'))]"/>
    </record>
</odoo>