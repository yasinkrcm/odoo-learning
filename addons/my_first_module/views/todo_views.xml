<odoo>
    <record id="view_todo_list" model="ir.ui.view">
        <field name="name">my.todo.list</field>
        <field name="model">my.todo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="deadline"/>
                <field name="is_done"/>
                <field name="user_id"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="view_todo_form" model="ir.ui.view">
        <field name="name">my.todo.form</field>
        <field name="model">my.todo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object" string="Mark as Done"
                            class="btn-primary" invisible="is_done"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="deadline"/>
                        <field name="is_done"/>
                        <field name="user_id"/>
                        <field name="partner_id"/>
                        <field name="partner_is_vip"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_todo" model="ir.actions.act_window">
        <field name="name">Todos</field>
        <field name="res_model">my.todo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_todo_root" name="My Todos" sequence="10"/>
    <menuitem id="menu_todo_action" name="Todos" parent="menu_todo_root" action="action_todo"/>
</odoo>